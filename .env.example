# Copy to .env and fill in. Never commit the real .env file.
# docker compose refuses to start if a required value is empty.

# --- Database ---
POSTGRES_DB=edupulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Host port, bound to localhost only (5434 avoids clashes with other local databases)
POSTGRES_PORT=5434

# --- Vector store (Qdrant, used instead of pgvector) ---
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=edupulse_rag

# --- LLM and embeddings (OpenAI) ---
LLM_API_KEY=
# The OpenAI SDK used by Spring AI 2.0 needs the /v1 suffix
LLM_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Must equal the embedding model's vector size (1536 for text-embedding-3-small).
EMBEDDING_DIMENSIONS=1536

# --- Gateway ---
GATEWAY_PORT=8080

# --- Story 1: ingestion and chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Story 2: dynamic ingestion security ---
VENDOR_WEBHOOK_SECRET=change-me
# Comma-separated allowlist of credible sources
INGEST_ALLOWED_DOMAINS=owasp.org,cheatsheetseries.owasp.org,cwe.mitre.org,github.com
INGEST_MAX_SIZE_MB=20

# --- Stories 3 and 4: retrieval tuning ---
RETRIEVAL_TOP_K=20
SIMILARITY_THRESHOLD=0.70
QUERY_EXPANSION_VARIANTS=3
RERANK_TOP_K=5
STITCH_TOKEN_BUDGET=2000
